{
    "name": "nodejs-webapp",
    "version": "1.0.0",
    "main": "server.js",
    "scripts": {
        "start": "node server.js",
        "dev": "nodemon server.js",
        "test": "jest --coverage",
        "test:unit": "jest --coverage --testPathPattern=tests/unit",
        "test:integration": "jest --coverage --testPathPattern=tests/integration",
        "test:acceptance": "jest --coverage --testPathPattern=tests/acceptance"
},
"dependencies": {
    "express": "^4.18.2",
    "ejs": "^3.1.9",
    "body-parser": "^1.20.2"
},
"devDependencies": {
    "jest": "^29.6.1",
    "supertest": "^6.4.3",
    "nodemon": "^2.0.22"
},
"jest": {
    "testEnvironment": "node",
    "collectCoverageFrom": [
    "**/*.js",
    "!node_modules/**",
    "!tests/**"
],
"coverageThreshold": {
    "global": {
    "branches": 90,
    "functions": 90,
    "lines": 90,
    "statements": 90
    }
   }
  }
}